<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1>Products</h1>

<div>
  <%= form_with(url: search_products_path, method: :get) do %>
  <%= label_tag :keywords, "Search for Products or Brands" %>
  <%= text_field_tag :keywords, params[:keywords], placeholder: "Enter Brand or Product" %>
  <%= submit_tag "Search" %>
  <% end %>
</div>

<div>
  <%= form_with(url: search_products_path, method: :get) do %>
  <%= label_tag :equipment_type, "Choose Equipment Type" %>
  <%= select_tag :equipment_type, options_for_select(Category.pluck(:equipment_type), selected: params[:equipment_type]), prompt: "Select an Equipment Type" %>
  <%= submit_tag "Search" %>
<% end %>
</div>

<div id="products">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <%= render product %>
      <p>
        <%= link_to "Show this product", product %>
      </p>
    <% end %>
  <% else %>
    <p>No products found.</p>
  <% end %>
</div>

<div>
  <%= paginate @products %>
</div>
