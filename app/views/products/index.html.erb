<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>
<div>
<h1>Products</h1>
  <%= form_with(url: search_products_path, method: :get) do %>
  <%= label_tag :equipment_type, "Choose Equipment Type" %>
  <%= select_tag :equipment_type, options_for_select(Category.pluck(:equipment_type), selected: params[:equipment_type]), prompt: "Select an Equipment Type" %>
  <%= submit_tag "Search" %>
<% end %>
</div>

<div id="products">
  <% @products.each do |product| %>
    <%= render product %>
    <p>
      <%= link_to "Show this product", product %>
    </p>
  <% end %>
</div>
