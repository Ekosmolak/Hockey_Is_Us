<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>
<div>
  <h1 class="text-center">Products</h1><br>
</div>

<div class="mb-4">
  <%= form_with(url: search_products_path, method: :get, class: "d-flex justify-content-center") do %>
    <%= label_tag :keywords, "Search for Products or Brands", class: "me-2" %>
    <%= text_field_tag :keywords, params[:keywords], placeholder: "Enter Brand or Product", class: "form-control me-2" %>
    <%= submit_tag "Search", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="mb-4">
  <%= form_with(url: search_products_path, method: :get, class: "d-flex justify-content-center") do %>
    <%= label_tag :equipment_type, "Choose Equipment Type", class: "me-2" %>
    <%= select_tag :equipment_type, options_for_select(Category.pluck(:equipment_type), selected: params[:equipment_type]), prompt: "Select an Equipment Type", class: "form-select me-2" %>
    <%= submit_tag "Search", class: "btn btn-primary" %>
  <% end %>
</div>

<div id="products" class="row row-cols-1 row-cols-md-3 g-4">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <div class="col">
        <%= render partial: "product", locals: { product: product } %>
      </div>
    <% end %>
  <% else %>
    <p class="text-center">No products found.</p>
  <% end %>
</div>

<div class="d-flex justify-content-center mt-4">
  <%= paginate @products %>
</div>
