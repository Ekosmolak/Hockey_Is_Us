<div id="<%= dom_id product %>" class="card mb-4 shadow-sm">
  <% if product.image&.attached? %>
    <%= image_tag product.image, class: "card-img-top", alt: "#{product.model} image", style: "max-width: 350px; height: 350px;" %>
  <% end %>
  <div class="card-body">
    <h5 class="card-title"><%= link_to product.model, product, class: "text-decoration-none" %></h5>

    <p class="card-text">
      <strong>Brand:</strong> <%= product.brand.name %><br>
      <strong>Model:</strong> <%= product.model %><br>
      <strong>Category:</strong> <%= product.category.equipment_type %><br>
      <strong>Price:</strong> <%= number_to_currency(product.price) %><br>
            <% if controller.action_name == "show" %>
        <strong>Description:</strong> <%= product.description %>
      <% end %>
    </p>

    <% if cart.include?(product) %>
      <%= button_to cart_path(product), method: :delete, class: "btn btn-danger btn-sm" do %>
        Remove from cart ⊖
      <% end %>
    <% else %>
      <%= form_with url: cart_index_path, method: :create, local: true, class: "d-inline-block" do |form| %>
        <%= hidden_field_tag(:id, product.id) %>
        <%= button_tag 'Add to Cart ➕', class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>
