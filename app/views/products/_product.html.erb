<div id="<%= dom_id product %>">
  <% if product.image&.attached? %>
    <p>
      <%= image_tag product.image, width: "300", height: "auto" %>
    </p>
  <% end %>

  <p>
    <strong>Brand:</strong>
    <%= product.brand.name %>
  </p>

  <p>
    <strong>Model:</strong>
    <%= product.model %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= product.category.equipment_type %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= number_to_currency(product.price) %>
  </p>
</div>