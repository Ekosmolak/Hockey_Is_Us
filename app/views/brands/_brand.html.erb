<div id="<%= dom_id brand %>" class="card mb-4 shadow-sm">
  <% if brand.image&.attached? %>
    <%= image_tag brand.image, class: "card-img-top", alt: "#{brand.name} image", style: "max-width: 100%; height: auto;" %>
  <% end %>

  <div class="card-body">
    <h5 class="card-title text-center"><%= brand.name %></h5>
  </div>
</div>
