<div id="<%= dom_id brand %>" class="card mb-4 shadow-sm">
  <% if brand.image&.attached? %>
    <%= image_tag brand.image, class: "card-img-top", alt: "#{brand.name} image", style: "width: 350px; height: 200px;" %>
  <% end %>

  <div class="card-body">
    <strong class="card-title text-center"><%= brand.name %></strong>
  </div>
</div>
