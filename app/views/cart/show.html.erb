<h1>Your Shopping Cart</h1>

<% if @cart_items.present? %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |item| %>
        <tr>
          <td><%= item.model %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency(item.product.price_cents / 100.0) %></td>
          <td><%= button_to 'Remove', cart_path(item), method: :delete %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= link_to 'Checkout', checkout_path, class: 'button' %>
<% else %>
  <p>Your cart is empty.</p>
<% end %>